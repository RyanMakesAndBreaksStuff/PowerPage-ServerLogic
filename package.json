{
  "name": "@ryanmakes/powerpages-serverlogic",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:beta": "tsc -b && vite build --mode beta",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "dev-watch": "vite build --mode development --watch",
    "finalize-package": "npm shrinkwrap",
    "validate": "pptb-validate",
    "version-stable": "npm version patch --no-git-tag-version",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "probe:size": "vite build --mode probe && node scripts/bundle-size.mjs dist-probe",
    "size": "node scripts/bundle-size.mjs dist/assets"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fluentui/react-icons": "^2.0.344",
    "@lezer/highlight": "^1.2.5",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "fflate": "^0.8.3",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@pptb/types": "^1.2.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "displayName": "Server Logic Tools",
  "description": "Generate Power Pages server logic handlers, client calls and permission checklists, and browse the Server.* object reference.",
  "main": "index.html",
  "icon": "icons/server-logic-tools.svg",
  "license": "BSD-3-Clause",
  "author": "Ryan Christopher",
  "contributors": [
    {
      "name": "Ryan Christopher",
      "url": "https://github.com/RyanMakesAndBreaksStuff"
    }
  ],
  "configurations": {
    "repository": "https://github.com/RyanMakesAndBreaksStuff/PowerPage-ServerLogic",
    "readmeUrl": "https://raw.githubusercontent.com/RyanMakesAndBreaksStuff/PowerPage-ServerLogic/main/README.md"
  },
  "features": {
    "connections": {
      "min": 0,
      "max": 1
    },
    "minAPI": "1.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyanMakesAndBreaksStuff/PowerPage-ServerLogic.git"
  },
  "keywords": [
    "powerplatform",
    "dataverse",
    "toolbox",
    "power-pages",
    "server-logic"
  ]
}
