{
  "name": "@ryanmakes/powerpages-serverlogic",
  "version": "1.0.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "dev-watch": "vite build --mode development --watch",
    "finalize-package": "npm shrinkwrap",
    "validate": "pptb-validate --skip-url-checks",
    "version-stable": "npm version patch --no-git-tag-version",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fluentui/react-icons": "^2.0.344",
    "@lezer/highlight": "^1.2.5",
    "acorn": "^8.19.0",
    "fflate": "^0.8.3",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@pptb/types": "^1.2.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "displayName": "Power Pages Server Logic",
  "description": "Generate Power Pages server logic starters, browse the Server.* reference, and check a site's server logic readiness.",
  "main": "index.html",
  "icon": "icons/logo.svg",
  "license": "BSD-3-Clause",
  "author": "Ryan Rettinger",
  "contributors": [
    {
      "name": "Ryan Rettinger",
      "url": "https://github.com/RyanMakesAndBreaksStuff"
    }
  ],
  "configurations": {
    "repository": "https://github.com/RyanMakesAndBreaksStuff/PowerPage-ServerLogic",
    "website": "https://github.com/RyanMakesAndBreaksStuff/PowerPage-ServerLogic/blob/main/docs/usage-manual.md",
    "readmeUrl": "https://raw.githubusercontent.com/RyanMakesAndBreaksStuff/PowerPage-ServerLogic/main/README.md"
  },
  "features": {
    "connections": {
      "min": 0,
      "max": 1
    },
    "minAPI": "1.2.7"
  },
  "homepage": "https://github.com/RyanMakesAndBreaksStuff/PowerPage-ServerLogic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyanMakesAndBreaksStuff/PowerPage-ServerLogic.git"
  },
  "bugs": {
    "url": "https://github.com/RyanMakesAndBreaksStuff/PowerPage-ServerLogic/issues"
  },
  "keywords": [
    "power-platform",
    "power-pages",
    "power-platform-toolbox",
    "dataverse",
    "server-logic",
    "pptb",
    "microsoft",
    "power-apps-portal"
  ],
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.3"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.3"
    },
    "@eslint/eslintrc": {
      "minimatch": "^11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.3"
    }
  }
}