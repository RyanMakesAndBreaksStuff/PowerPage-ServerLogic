{
  "name": "Host calls without a connection: event subscription after reload, Starter save paths, retrieval-only guard",
  "vars": {
    "toolPath": "C:/Users/RyanDev/source/repos/Server Logic"
  },
  "steps": [
    {
      "name": "open the built tool",
      "open": "{{toolPath}}",
      "as": "tool",
      "critical": true
    },
    {
      "name": "remove intercepts left by an earlier run",
      "clearIntercepts": "all"
    },
    {
      "name": "mark host calls (c0)",
      "calls": "{{tool}}",
      "mark": "c0",
      "expect": {
        "type": "array"
      }
    },
    {
      "name": "reload the tool",
      "reload": "{{tool}}"
    },
    {
      "name": "Starter is selected after reload",
      "eval": "document.querySelector('[role=tab][aria-selected=true]')?.id",
      "waitFor": {
        "timeoutMs": 10000
      },
      "expect": {
        "equals": "tab-starter"
      }
    },
    {
      "name": "mark host calls (beforeEvent)",
      "calls": "{{tool}}",
      "mark": "beforeEvent",
      "expect": {
        "type": "array"
      }
    },
    {
      "name": "the host raises settings:updated",
      "event": "settings:updated",
      "data": {}
    },
    {
      "name": "let the theme re-read settle",
      "sleep": 1500
    },
    {
      "name": "the theme is re-read exactly once after a reload (fix-7 #7)",
      "calls": "{{tool}}",
      "channel": "get-current-theme",
      "since": "{{beforeEvent}}",
      "expect": {
        "length": 1
      }
    },
    {
      "name": "save dialog returns a path",
      "intercept": "{{tool}}",
      "channel": "filesystem:save-file",
      "times": 1,
      "action": {
        "kind": "respond",
        "value": "C:/probe-out/customer-summary.zip"
      }
    },
    {
      "name": "mark host calls (save1)",
      "calls": "{{tool}}",
      "mark": "save1",
      "expect": {
        "type": "array"
      }
    },
    {
      "name": "choose Download starter",
      "eval": "([...document.querySelectorAll(\"#panel-starter button\")].find((e) => e.textContent.trim() === \"Download starter\").click(), true)"
    },
    {
      "name": "success notification within 2 s (AC-5.11)",
      "calls": "{{tool}}",
      "channel": "show-notification",
      "since": "{{save1}}",
      "argsContains": "customer-summary.zip downloaded",
      "waitFor": {
        "timeoutMs": 2000
      },
      "expect": {
        "minLength": 1
      }
    },
    {
      "name": "the zip reaches the host as bytes",
      "calls": "{{tool}}",
      "channel": "filesystem:save-file",
      "since": "{{save1}}",
      "expect": {
        "all": [
          {
            "path": "0.args.1.binary",
            "equals": true
          },
          {
            "path": "0.args.1.head",
            "matches": "^504b0304"
          }
        ]
      }
    },
    {
      "name": "save dialog is cancelled",
      "intercept": "{{tool}}",
      "channel": "filesystem:save-file",
      "times": 1,
      "action": {
        "kind": "respond",
        "value": null
      }
    },
    {
      "name": "mark host calls (save2)",
      "calls": "{{tool}}",
      "mark": "save2",
      "expect": {
        "type": "array"
      }
    },
    {
      "name": "choose Download starter again",
      "eval": "([...document.querySelectorAll(\"#panel-starter button\")].find((e) => e.textContent.trim() === \"Download starter\").click(), true)"
    },
    {
      "name": "the cancelled save call arrives",
      "calls": "{{tool}}",
      "channel": "filesystem:save-file",
      "since": "{{save2}}",
      "waitFor": {
        "timeoutMs": 5000
      },
      "expect": {
        "length": 1
      }
    },
    {
      "name": "wait for any late notification",
      "sleep": 1500
    },
    {
      "name": "a cancelled save shows no notification",
      "calls": "{{tool}}",
      "channel": "show-notification",
      "since": "{{save2}}",
      "expect": {
        "length": 0
      }
    },
    {
      "name": "the host fails the save",
      "intercept": "{{tool}}",
      "channel": "filesystem:save-file",
      "times": 1,
      "action": {
        "kind": "error",
        "message": "EACCES: permission denied"
      }
    },
    {
      "name": "mark host calls (save3)",
      "calls": "{{tool}}",
      "mark": "save3",
      "expect": {
        "type": "array"
      }
    },
    {
      "name": "choose Download starter a third time",
      "eval": "([...document.querySelectorAll(\"#panel-starter button\")].find((e) => e.textContent.trim() === \"Download starter\").click(), true)"
    },
    {
      "name": "failure notification names the file",
      "calls": "{{tool}}",
      "channel": "show-notification",
      "since": "{{save3}}",
      "argsContains": "Couldn't save customer-summary.zip",
      "waitFor": {
        "timeoutMs": 5000
      },
      "expect": {
        "minLength": 1
      }
    },
    {
      "name": "the notification carries no host error text",
      "calls": "{{tool}}",
      "channel": "show-notification",
      "since": "{{save3}}",
      "argsContains": "Error invoking remote method",
      "expect": {
        "length": 0
      }
    },
    {
      "name": "no dataverse.create call",
