{
  "name": "Site list host failures map to plain-language messages (A3)",
  "vars": {
    "toolPath": "C:/Users/RyanDev/source/repos/Server Logic"
  },
  "steps": [
    {
      "name": "open the built tool",
      "open": {
        "localPath": "{{toolPath}}",
        "connectionName": "{{connectionName}}"
      },
      "as": "tool",
      "critical": true
    },
    {
      "name": "remove intercepts left by an earlier run",
      "clearIntercepts": "all"
    },
    {
      "name": "mark host calls (c0)",
      "calls": "{{tool}}",
      "mark": "c0",
      "expect": {
        "type": "array"
      }
    },
    {
      "name": "401: clear intercepts",
      "clearIntercepts": "{{tool}}"
    },
    {
      "name": "401: the host rejects the site list read",
      "intercept": "{{tool}}",
      "channel": "dataverse.queryData",
      "argsContains": "powerpagesites?",
      "times": 1,
      "action": {
        "kind": "error",
        "message": "HTTP 401"
      }
    },
    {
      "name": "401: reload",
      "reload": "{{tool}}"
    },
    {
      "name": "open Logic Inspector",
      "eval": "(document.querySelector('#tab-inspector').click(), true)",
      "waitFor": {
        "timeoutMs": 10000
      },
      "expect": {
        "equals": true
      }
    },
    {
      "name": "401: Inspector shows \"Couldn't load sites\"",
      "eval": "[...document.querySelectorAll('#panel-inspector h2')].map((h) => h.textContent.trim())",
      "waitFor": {
        "timeoutMs": 15000
      },
      "expect": {
        "contains": "Couldn't load sites"
      }
    },
    {
      "name": "401: no host error text on screen",
      "eval": "document.querySelector('#panel-inspector').innerText",
      "expect": {
        "all": [
          {
            "notContains": "Error invoking remote method"
          },
          {
            "notContains": "0x8"
          },
          {
            "notContains": "ENOTFOUND"
          }
        ]
      }
    },
    {
      "name": "401: plain-language message",
      "eval": "document.querySelector('#panel-inspector p.inspector-state__text')?.textContent.trim()",
      "expect": {
        "equals": "Authentication failed. Please reconnect."
      }
    },
    {
      "name": "401: recover",
      "clearIntercepts": "{{tool}}"
    },
    {
      "name": "canned site list",
      "intercept": "{{tool}}",
      "channel": "dataverse.queryData",
      "argsContains": "powerpagesites?",
      "action": {
        "kind": "respond",
        "value": {
          "value": [
            {
              "powerpagesiteid": "00000000-0000-4000-8000-000000000001",
              "name": "Alpha portal",
              "primarydomainname": "alpha.example.com",
              "statecode": 0
            },
            {
              "powerpagesiteid": "00000000-0000-4000-8000-000000000002",
              "name": "Beta portal",
              "primarydomainname": "beta.example.com",
              "statecode": 0
            },
            {
              "powerpagesiteid": "00000000-0000-4000-8000-000000000003",
              "name": "Retired portal",
              "primarydomainname": "retired.example.com",
              "statecode": 1
            }
          ]
        }
      }
    },
    {
      "name": "401: retry",
      "eval": "([...document.querySelectorAll(\"#panel-inspector button\")].find((e) => e.textContent.trim() === \"Retry\").click(), true)"
    },
    {
      "name": "401: Inspector shows \"Select a site\"",
      "eval": "[...document.querySelectorAll('#panel-inspector h2')].map((h) => h.textContent.trim())",
      "waitFor": {
        "timeoutMs": 15000
      },
      "expect": {
        "contains": "Select a site"
