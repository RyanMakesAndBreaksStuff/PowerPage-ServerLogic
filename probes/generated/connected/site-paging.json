{
  "name": "Site list paging: the issued nextLink reaches the host unchanged (RG-001 tool half)",
  "vars": {
    "toolPath": "C:/Users/RyanDev/source/repos/Server Logic"
  },
  "steps": [
    {
      "name": "open the built tool",
      "open": {
        "localPath": "{{toolPath}}",
        "connectionName": "{{connectionName}}"
      },
      "as": "tool",
      "critical": true
    },
    {
      "name": "remove intercepts left by an earlier run",
      "clearIntercepts": "all"
    },
    {
      "name": "mark host calls (c0)",
      "calls": "{{tool}}",
      "mark": "c0",
      "expect": {
        "type": "array"
      }
    },
    {
      "name": "first page carries a nextLink",
      "intercept": "{{tool}}",
      "channel": "dataverse.queryData",
      "argsContains": "powerpagesites?",
      "times": 1,
      "action": {
        "kind": "respond",
        "value": {
          "value": [
            {
              "powerpagesiteid": "00000000-0000-4000-8000-000000000001",
              "name": "Alpha portal",
              "primarydomainname": "alpha.example.com",
              "statecode": 0
            }
          ],
          "@odata.nextLink": "https://example.crm.dynamics.com/api/data/v9.2/powerpagesites?$select=powerpagesiteid,name,primarydomainname,statecode&$orderby=name,powerpagesiteid&$skiptoken=%3Ccookie%20pagenumber=%222%22%20pagingcookie=%22%253ccookie%2520page%253d%25221%2522%253e%22%20/%3E"
        }
      }
    },
    {
      "name": "second page ends the list",
      "intercept": "{{tool}}",
      "channel": "dataverse.queryData",
      "argsContains": "$skiptoken",
      "action": {
        "kind": "respond",
        "value": {
          "value": [
            {
              "powerpagesiteid": "00000000-0000-4000-8000-000000000002",
              "name": "Beta portal",
              "primarydomainname": "beta.example.com",
              "statecode": 0
            },
            {
              "powerpagesiteid": "00000000-0000-4000-8000-000000000003",
              "name": "Retired portal",
              "primarydomainname": "retired.example.com",
              "statecode": 1
            }
          ]
        }
      }
    },
    {
      "name": "mark host calls (paging)",
      "calls": "{{tool}}",
      "mark": "paging",
      "expect": {
        "type": "array"
      }
    },
    {
      "name": "reload so the site list is read through the intercepts",
      "reload": "{{tool}}"
    },
    {
      "name": "open Logic Inspector",
      "eval": "(document.querySelector('#tab-inspector').click(), true)",
      "waitFor": {
        "timeoutMs": 10000
      },
      "expect": {
        "equals": true
      }
    },
    {
      "name": "paging: Inspector shows \"Select a site\"",
      "eval": "[...document.querySelectorAll('#panel-inspector h2')].map((h) => h.textContent.trim())",
      "waitFor": {
        "timeoutMs": 15000
      },
      "expect": {
        "contains": "Select a site"
      }
    },
    {
      "name": "the tool passed the issued nextLink to the host unchanged",
      "calls": "{{tool}}",
      "channel": "dataverse.queryData",
      "since": "{{paging}}",
      "argsContains": "$skiptoken",
      "expect": {
        "path": "0.args.0",
        "equals": "powerpagesites?$select=powerpagesiteid,name,primarydomainname,statecode&$orderby=name,powerpagesiteid&$skiptoken=%3Ccookie%20pagenumber=%222%22%20pagingcookie=%22%253ccookie%2520page%253d%25221%2522%253e%22%20/%3E"
      }
    },
    {
      "name": "open the site picker",
      "eval": "(document.querySelector('[role=combobox][aria-label=\"Power Pages site\"]').click(), true)"
    },
    {
      "name": "both pages are listed",
      "eval": "document.querySelectorAll(\"[role=listbox][aria-label=\\\"Power Pages site\\\"] [role=option]\").length",
      "waitFor": {
        "timeoutMs": 5000
      },
      "expect": {
        "equals": 3
      }
    },
    {
      "name": "no dataverse.create call",
      "calls": "{{tool}}",
      "channel": "dataverse.create",
      "since": "{{c0}}",
      "limit": 2000,
      "expect": {
        "length": 0
      }
    },
    {
      "name": "no dataverse.update call",
      "calls": "{{tool}}",
      "channel": "dataverse.update",
      "since": "{{c0}}",
      "limit": 2000,
      "expect": {
        "length": 0
      }
    },
    {
