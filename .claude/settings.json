{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git push *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ls *)",
      "Bash(npm outdated *)",
      "Bash(npm audit *)",
      "Bash(pnpm run *)",
      "Bash(pnpm test *)",
      "Bash(pnpm ls *)",
      "Bash(pnpm list *)",
      "Bash(pnpm outdated *)",
      "Bash(pnpm audit *)",
      "Bash(pnpm why *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier --check *)",
      "Bash(npx pptb-validate *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec prettier --check *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git blame *)",
      "Bash(git rev-parse *)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(pnpm --version)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Get-Command *)",
      "PowerShell(npm run *)",
      "PowerShell(pnpm run *)",
      "PowerShell(pnpm test *)",
      "PowerShell(npx pptb-validate *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:www.typescriptlang.org)",
      "WebFetch(domain:docs.powerplatformtoolbox.com)",
      "WebFetch(domain:code.claude.com)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(npm unpublish *)",
      "Bash(npm login *)",
      "Bash(npm adduser *)",
      "Bash(npm token *)",
      "Bash(npm config set *)",
      "Bash(pnpm config set *)",
      "Bash(npm install -g *)",
      "Bash(pnpm add -g *)",
      "Bash(npx -y *)",
      "Bash(npx --yes *)",
      "Bash(pnpm dlx *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(scp *)",
      "Bash(ssh *)",
      "Bash(eval *)",
      "Bash(pac auth create *)",
      "Bash(pac auth delete *)",
      "Bash(pac auth clear *)",
      "Bash(pac data *)",
      "Bash(pac solution import *)",
      "Bash(pac solution delete *)",
      "Bash(pac pages upload *)",
      "Bash(pac paportal upload *)",
      "Bash(pac env delete *)",
      "Bash(pac admin *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Invoke-Expression *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(Set-ExecutionPolicy *)",
      "PowerShell(Format-Volume *)",
      "PowerShell(powershell -EncodedCommand *)",
      "PowerShell(pwsh -EncodedCommand *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(npm publish *)",
      "PowerShell(pnpm publish *)",
      "PowerShell(pac auth create *)",
      "PowerShell(pac data *)",
      "PowerShell(pac solution import *)",
      "PowerShell(pac pages upload *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)",
      "Read(./.npmrc)",
      "Read(~/.npmrc)",
      "Read(./**/secrets/**)",
      "Read(~/AppData/Local/Microsoft/PowerAppsCli/**)",
      "Read(~/.azure/**)",
      "Read(~/.ssh/**)",
      "Read(~/.git-credentials)"
    ],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.CLAUDE_PROJECT_DIR||process.cwd(),'.claude','hooks','format-lint.cjs'))\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.CLAUDE_PROJECT_DIR||process.cwd(),'.claude','hooks','verify-on-stop.cjs'))\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "power-pages@power-platform-skills": true,
    "context-mode@context-mode": true
  }
}
